{
  "manifest_version": 3,
  "name": "Parallel Reader for Claude Academy",
  "short_name": "Parallel Reader",
  "version": "1.1.0",
  "description": "Read Claude Academy in your language with the English original under every paragraph. Unofficial.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://academy.claude.com/*"
      ],
      "js": [
        "locale.js",
        "match.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
